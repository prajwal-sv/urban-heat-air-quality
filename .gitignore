# ============================================================================
# Python Byte-compiled / optimized / DLL files
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# ============================================================================
# Distribution / packaging
# ============================================================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pyinstaller output
*.manifest
*.spec

# ============================================================================
# Virtual Environments (Crucial to ignore)
# ============================================================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# Poetry & Pipenv lock files and environments
#.poetry/
#   Note: It is usually recommended to commit poetry.lock 
#   but ignore personal configurations
.pypackages/
.pixi/

# ============================================================================
# Testing, Coverage, and Linting
# ============================================================================
.htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.pkl
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# ============================================================================
# Notebooks and Data Science
# ============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ============================================================================
# Environment Variables & Secrets (NEVER commit these)
# ============================================================================
.env
.env.*
.secrets
*.pem
*.key

# ============================================================================
# IDEs and Editors (Optional but highly recommended)
# ============================================================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
